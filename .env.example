# 运行模式：mock | real（具体能力由下方 provider 决定）
AI_MODE=real

# ---------------- LLM ----------------
# LLM 提供方：mock | deepseek | ark
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 火山方舟（ark LLM / Seedream / Seedance 时使用）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-1-6-250615
ARK_VISION_MODEL=doubao-seed-1-6-vision-250815
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528

# ---------------- 图片 / 视频 ----------------
# 图片：mock | rest | ark
IMAGE_PROVIDER=rest
# 视频：mock | rest | mcp | seedance
VIDEO_PROVIDER=rest

# REST 美术资源（图片 + 视频）
REST_ART_BASE_URL=
REST_ART_TOKEN=
REST_VIDEO_RESOLUTION=480p
REST_VIDEO_DURATION=4
REST_IMAGE_PARAMS={"aspectRatio":"portrait","quality":"high"}
REST_IMAGE_WAIT_SECONDS=30
REST_VIDEO_WAIT_SECONDS=30
REST_ART_TIMEOUT=1200

# MCP 视频（保留为回退）
MCP_VIDEO_URL=
MCP_VIDEO_TOKEN=
MCP_VIDEO_TOOL=video_generate
MCP_VIDEO_RESOLUTION=480p
MCP_VIDEO_DURATION=4
MCP_VIDEO_TIMEOUT=1200
MCP_VIDEO_POLL_SECONDS=60

# ---------------- 本地运行 ----------------
DATA_DIR=./data
DATABASE_URL=
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FPS=30
SYNC_JOBS=false
FFMPEG_BIN=
